# Server
NODE_ENV=development
PORT=3000

# Database: "sqlite" (default, no setup needed) or "postgres"
DB_DIALECT=sqlite
DB_STORAGE=./data/app.sqlite
DB_LOGGING=false

# Only used when DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=student_records
DB_USER=postgres
DB_PASSWORD=

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
